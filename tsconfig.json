{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "Node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "types": ["chrome", "node"]
  },
  "include": [
    "shared/**/*.ts",
    "collectors/**/*.ts",
    "redaction/**/*.ts",
    "report/**/*.ts",
    "extension/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
